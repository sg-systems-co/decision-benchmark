{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sg-systems-co/decision-benchmark/blob/main/schemas/ap-invoices/v0.10/output.schema.json",
  "title": "Decision Benchmark, ap-invoices, v0.10: output for one case",
  "description": "One JSON object per case (JSONL). Output that breaks this schema, or names two decisions, is scored as a wrong decision. Country codes, rule IDs, buyer actions and line facts are in countries/*.schema.json. See docs/task-sets/ap-invoices/spec-v0.10.md.",
  "x-derive": {
    "summary_field": "tax_treatment",
    "lines_field": "tax_lines",
    "line_value_field": "treatment",
    "line_key_field": "line_no"
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "decision", "tax_treatment", "gl_account", "reason_codes"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "decision": {
      "type": "string",
      "enum": [
        "APPROVE",
        "DISPUTE_PRICE",
        "DISPUTE_QUANTITY",
        "HOLD_NOT_RECEIVED",
        "REJECT_DUPLICATE",
        "REQUEST_CORRECTED_INVOICE",
        "FRAUD_REVIEW",
        "ROUTE_FOR_APPROVAL",
        "HAND_OVER"
      ]
    },
    "tax_treatment": {
      "description": "Case-level tax treatment: the worst line, by the country part's x-severity-order. Singapore codes for SG cases, Malaysian codes for MY cases; a code from the other country is a wrong tax treatment, not a schema error. null only when decision is HAND_OVER.",
      "anyOf": [
        {"$ref": "countries/my.schema.json#/$defs/tax_code"},
        {"$ref": "countries/sg.schema.json#/$defs/tax_code"},
        {"type": "null"}
      ]
    },
    "gl_account": {
      "description": "One code from the company's chart of accounts. Scored as exact match. null only when decision is HAND_OVER.",
      "type": ["string", "null"],
      "minLength": 1
    },
    "reason_codes": {
      "description": "Short codes explaining the decision. A recommended list is in reason-codes.md; it is not enforced.",
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "confidence": {
      "description": "Optional. Needed for the risk-coverage curve.",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "explanation": {"description": "Optional free text. Never scored on the leaderboard.", "type": "string"},
    "tax_lines": {
      "description": "Optional. One entry per invoice line: its tax treatment (the country's code) and the rule ID that decides it. treatment is null only when decision is HAND_OVER. All lines of one output use one country's codes and rule IDs. Scored as an extra column, never in the main score.",
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {"$ref": "countries/my.schema.json#/$defs/tax_line"},
          {"$ref": "countries/sg.schema.json#/$defs/tax_line"}
        ]
      },
      "$ref": "#/$defs/unique_line_no"
    },
    "buyer_actions": {
      "description": "Optional. Actions the buyer itself must take besides the decision. Empty list when none apply. Scored as an extra column, never in the main score.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {"$ref": "countries/my.schema.json#/$defs/buyer_action"},
          {"$ref": "countries/sg.schema.json#/$defs/buyer_action"}
        ]
      }
    },
    "facts": {
      "description": "Optional. Per invoice line, the facts the rules turn on, each with its value and evidence in the case documents. Scored separately (facts score); leaving it out never lowers the main score.",
      "type": "object",
      "additionalProperties": false,
      "required": ["lines"],
      "properties": {
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {"$ref": "countries/my.schema.json#/$defs/line_facts"},
              {"$ref": "countries/sg.schema.json#/$defs/line_facts"}
            ]
          },
          "$ref": "#/$defs/unique_line_no"
        }
      }
    }
  },
  "allOf": [
    {
      "description": "Unless the decision is HAND_OVER, tax_treatment, gl_account and every line treatment are set.",
      "if": {"properties": {"decision": {"not": {"const": "HAND_OVER"}}}},
      "then": {
        "properties": {
          "tax_treatment": {"type": "string"},
          "gl_account": {"type": "string"},
          "tax_lines": {"items": {"properties": {"treatment": {"type": "string"}}}}
        }
      }
    },
    {"$ref": "countries/my.schema.json#/$defs/case_summary"},
    {"$ref": "countries/sg.schema.json#/$defs/case_summary"}
  ],
  "$defs": {
    "line_no": {
      "description": "Invoice line number, as printed on the invoice.",
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "simple_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {"action": {"type": "string"}}
    },
    "withhold_tax": {
      "description": "WITHHOLD_TAX: rate in percent, the WH rule ID, and the amount the rate applies to, in the invoice currency.",
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "rate", "basis", "base_amount"],
      "properties": {
        "action": {"const": "WITHHOLD_TAX"},
        "rate": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
        "basis": {"type": "string"},
        "base_amount": {"type": "string", "pattern": "^\\d+(\\.\\d{1,2})?$"}
      }
    },
    "evidence": {
      "description": "Where a fact is shown: doc_id names a case document (invoice id, PO number, receipt id, email message id, supplier or company record id, policy-pack file name); then either path (a field path in its structured record, e.g. lines[2].description) or span (character offsets into its text, end exclusive).",
      "type": "object",
      "additionalProperties": false,
      "required": ["doc_id"],
      "properties": {
        "doc_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "span": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}}
        },
        "quote": {"type": "string", "description": "Optional. The text at the span or path, for readers."}
      },
      "oneOf": [{"required": ["path"]}, {"required": ["span"]}]
    },
    "fact": {
      "description": "One fact: value, and evidence for it. value null means the documents don't show the fact; it then has no evidence. Any other value needs at least one evidence reference.",
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {"value": {}, "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}},
      "if": {"properties": {"value": {"type": "null"}}},
      "then": {"not": {"required": ["evidence"]}},
      "else": {"required": ["evidence"]}
    },
    "unique_line_no": {
      "$comment": "Derived by schemas/derive.py from $defs/line_no. Do not edit by hand.",
      "description": "No line_no appears twice.",
