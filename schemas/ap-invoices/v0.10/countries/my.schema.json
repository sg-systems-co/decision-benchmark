    "case_summary": {
      "$comment": "Derived by schemas/derive.py from x-severity-order. Do not edit by hand.",
      "description": "A set tax_treatment is the worst treatment in tax_lines, by x-severity-order.",
      "allOf": [
        {
          "if": {
            "required": ["tax_treatment", "tax_lines"],
            "properties": {"tax_treatment": {"const": "SST_SUPPLIER_NOT_REGISTERED"}}
          },
          "then": {
            "properties": {
              "tax_lines": {
                "items": {
                  "required": ["treatment"],
                  "properties": {
                    "treatment": {
                      "enum": [
                        "SST_SUPPLIER_NOT_REGISTERED",
                        "SST_NOT_CHARGEABLE_BY_TRADER",
                        "SST_SHOULD_BE_EXEMPT",
                        "SST_WRONG_RATE",
                        "SST_UNDERCHARGED",
                        "SST_CORRECT",
                        "SST_BUYER_ACCOUNTS",
                        "NO_SST"
                      ]
                    }
                  }
                },
                "contains": {
                  "required": ["treatment"],
                  "properties": {"treatment": {"const": "SST_SUPPLIER_NOT_REGISTERED"}}
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["tax_treatment", "tax_lines"],
            "properties": {"tax_treatment": {"const": "SST_NOT_CHARGEABLE_BY_TRADER"}}
          },
          "then": {
            "properties": {
              "tax_lines": {
                "items": {
                  "required": ["treatment"],
                  "properties": {
                    "treatment": {
                      "enum": [
                        "SST_NOT_CHARGEABLE_BY_TRADER",
                        "SST_SHOULD_BE_EXEMPT",
                        "SST_WRONG_RATE",
                        "SST_UNDERCHARGED",
                        "SST_CORRECT",
                        "SST_BUYER_ACCOUNTS",
                        "NO_SST"
                      ]
                    }
                  }
                },
                "contains": {
                  "required": ["treatment"],
                  "properties": {"treatment": {"const": "SST_NOT_CHARGEABLE_BY_TRADER"}}
                }
              }
