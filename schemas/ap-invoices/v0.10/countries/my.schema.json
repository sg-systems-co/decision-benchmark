{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sg-systems-co/decision-benchmark/blob/main/schemas/ap-invoices/v0.10/countries/my.schema.json",
  "title": "Decision Benchmark, ap-invoices, v0.10: Malaysia part",
  "description": "Everything in the output that is specific to Malaysia: tax-treatment codes with their definitions and rule IDs (docs/tax-rules-v0.10.md), the worst-line order, rule IDs, buyer actions and line facts. output.schema.json refers here.",
  "x-country": "MY",
  "x-severity-order": [
    "SST_SUPPLIER_NOT_REGISTERED",
    "SST_NOT_CHARGEABLE_BY_TRADER",
    "SST_SHOULD_BE_EXEMPT",
    "SST_WRONG_RATE",
    "SST_UNDERCHARGED",
    "SST_CORRECT",
    "SST_BUYER_ACCOUNTS",
    "NO_SST"
  ],
  "$defs": {
    "tax_code": {
      "oneOf": [
        {
          "const": "SST_SUPPLIER_NOT_REGISTERED",
          "description": "Service tax or sales tax charged by a supplier that is not registered for it (and not liable to be) on the invoice date.",
          "x-rules": ["MS-1", "MG-1"]
        },
        {
          "const": "SST_NOT_CHARGEABLE_BY_TRADER",
          "description": "Sales tax charged by a trader, distributor or retailer reselling goods it did not manufacture. Sales tax is single-stage: only a registered manufacturer charges it, on taxable goods it manufactured and sold.",
          "x-rules": ["MG-1"]
        },
        {
          "const": "SST_SHOULD_BE_EXEMPT",
          "description": "Tax charged where an exclusion, exemption, relief or area rule means none is due (item exclusions, B2B exemptions, group relief, designated and special areas, Ministerial exemptions K-x, L-x, P-x, G-x, exempt goods, Schedule A/B/C).",
          "x-rules": ["MS-1", "MS-4", "MS-5", "MS-6", "MS-7", "MS-10", "MG-2", "MG-4", "MG-5", "MG-6"]
        },
        {
          "const": "SST_WRONG_RATE",
          "description": "Tax charged at a rate other than the one for the service or tariff code and the dates on the documents, higher or lower.",
          "x-rules": ["MS-2", "MS-3", "MG-2", "MG-3"]
        },
        {
          "const": "SST_UNDERCHARGED",
          "description": "Service tax left off a taxable line to a buyer with no exemption. The buyer owes only what is invoiced, but the invoice is wrong.",
          "x-rules": ["MS-9"]
        },
        {
          "const": "SST_CORRECT",
          "description": "Tax due and charged at the right rate by a supplier entitled to charge it.",
          "x-rules": ["MS-1", "MS-2", "MG-1", "MG-2"]
        },
        {
          "const": "SST_BUYER_ACCOUNTS",
          "description": "Imported taxable service: the overseas supplier correctly shows no SST, and the buyer accounts for service tax itself (Service Tax Act s26, s26A). Comes with the buyer action ACCOUNT_IMPORTED_SERVICE_TAX.",
          "x-rules": ["MS-8"]
        },
        {
          "const": "NO_SST",
          "description": "No SST due and none charged.",
          "x-rules": ["MS-1", "MS-8", "MG-2"]
        }
      ]
    },
    "rule_id": {
      "enum": [
        "MS-1",
        "MS-2",
        "MS-3",
        "MS-4",
        "MS-5",
        "MS-6",
        "MS-7",
        "MS-8",
        "MS-9",
        "MS-10",
        "MG-1",
        "MG-2",
        "MG-3",
        "MG-4",
        "MG-5",
        "MG-6",
        "ME-1",
        "ME-2",
        "ME-3",
        "ME-4",
        "K-1",
        "K-2",
        "K-3",
        "K-4",
        "K-5",
        "K-6",
        "K-7",
        "K-8",
        "L-1",
        "L-2",
        "L-3",
        "L-4",
        "L-5",
        "L-6",
        "L-7",
        "L-8",
        "P-1",
        "P-2",
        "P-3",
        "P-4",
        "P-5",
        "P-6",
        "P-7",
        "P-8",
        "P-9",
        "P-10",
        "P-11",
        "P-12",
        "P-13",
        "P-14",
        "P-15",
        "P-16",
        "P-17",
        "P-18",
        "P-19",
        "P-20",
        "P-21",
        "G-1",
        "G-2",
        "G-3",
        "G-4",
        "G-5",
        "G-6",
        "G-7",
        "WH-1",
        "WH-2",
        "WH-3",
        "WH-4"
      ]
    },
    "tax_line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line_no", "treatment", "basis"],
      "properties": {
        "line_no": {"$ref": "../output.schema.json#/$defs/line_no"},
        "treatment": {"anyOf": [{"$ref": "#/$defs/tax_code"}, {"type": "null"}]},
        "basis": {"$ref": "#/$defs/rule_id"}
      }
    },
    "buyer_action": {
      "oneOf": [
        {
          "$ref": "../output.schema.json#/$defs/simple_action",
          "properties": {"action": {"enum": ["ACCOUNT_IMPORTED_SERVICE_TAX", "ISSUE_SELF_BILLED_EINVOICE"]}}
        },
        {
          "$ref": "../output.schema.json#/$defs/withhold_tax",
          "properties": {"basis": {"enum": ["WH-1", "WH-2", "WH-3", "WH-4"]}}
        }
      ]
    },
    "line_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line_no"],
      "minProperties": 2,
      "properties": {
        "line_no": {"$ref": "../output.schema.json#/$defs/line_no"},
        "service_item": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "First Schedule item of the service, e.g. G(c), J1(d), I8, K, L. null: the line is not a service.",
          "x-family": "classification",
          "x-rules": ["MS-4", "MS-5", "MS-6"],
          "properties": {"value": {"type": ["string", "null"], "pattern": "^[A-M]([0-9]+)?(\\([a-z]\\))?$"}}
        },
        "tariff_code": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "Tariff code of the goods, as precise as the documents show, e.g. 8711.20.96 00. null: the line is not goods.",
          "x-family": "classification",
          "x-rules": ["MG-2", "MG-6"],
          "properties": {"value": {"type": ["string", "null"], "pattern": "^\\d{4}(\\.\\d{2}){0,2}( \\d{2})?$"}}
        },
        "fb_content": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "For Group A-E operators: what the line is, for the 6%/8% split.",
          "x-family": "classification",
          "x-rules": ["MS-2", "MS-4"],
          "properties": {
            "value": {
              "enum": [
                "food",
                "non_alcoholic_drink",
                "food_with_alcohol",
                "alcohol_alone",
                "corkage",
                "tobacco",
                "other",
                null
              ]
            }
          }
        },
        "financial_charge": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "For Group H: what the charge is.",
          "x-family": "classification",
          "x-rules": ["MS-4", "P-1", "P-3", "P-5", "P-6"],
          "properties": {
            "value": {
              "enum": [
                "fee_or_commission",
                "interest_or_profit",
                "penalty",
                "basic_banking",
                "insurance_premium",
                "reinsurance",
                "card_activation",
                null
              ]
            }
          }
        },
        "asset_type": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "For Group K: the rented asset.",
          "x-family": "classification",
          "x-rules": ["MS-4", "K-3"],
          "properties": {
            "value": {
              "enum": [
                "housing",
                "reading_material",
                "aircraft",
                "drone",
                "vessel",
                "floating_storage",
                "vehicle",
                "machinery",
                "commercial_premises",
                "other",
                null
              ]
            }
          }
        },
        "education_fee_item": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "For Group M: the fee item.",
          "x-family": "classification",
          "x-rules": ["MS-4", "P-16"],
          "properties": {
            "value": {
              "enum": [
                "tuition",
                "books",
                "uniform",
                "food",
                "transport",
                "accommodation",
                "refundable_deposit",
                "pta_fee",
                "trip",
                "student_pass",
                null
              ]
            }
          }
        },
        "service_period_start": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "First day of the service on this line.",
          "x-family": "time_and_rate",
          "x-rules": ["MS-3"],
          "properties": {"value": {"type": ["string", "null"], "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}}
        },
        "service_period_end": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "Last day of the service on this line.",
          "x-family": "time_and_rate",
          "x-rules": ["MS-3"],
          "properties": {"value": {"type": ["string", "null"], "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}}
        },
        "amount_paid_before_change": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "Amount received by the supplier before the rate change that the service spans.",
          "x-family": "time_and_rate",
          "x-rules": ["MS-3"],
          "properties": {"value": {"type": ["string", "null"], "pattern": "^-?\\d+(\\.\\d{1,2})?$"}}
        },
        "delivery_date": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "Delivery date of the goods.",
          "x-family": "time_and_rate",
          "x-rules": ["MG-3"],
          "properties": {"value": {"type": ["string", "null"], "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}}
        },
        "subject_outside_malaysia": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "The service concerns goods, land or matters outside Malaysia (Group G, H, I8 exclusions).",
          "x-family": "scope_and_exemption",
          "x-rules": ["MS-4"],
          "properties": {"value": {"type": ["boolean", "null"]}}
        },
        "statutory_fee_amount": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "Statutory fee to a government or statutory body included in the line (Group G(a)-(f)).",
          "x-family": "scope_and_exemption",
          "x-rules": ["MS-4"],
          "properties": {"value": {"type": ["string", "null"], "pattern": "^-?\\d+(\\.\\d{1,2})?$"}}
        },
        "residential": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "The work or maintenance is on a residential building or for its owner or occupant.",
          "x-family": "scope_and_exemption",
          "x-rules": ["MS-4", "L-5", "P-11"],
          "properties": {"value": {"type": ["boolean", "null"]}}
        },
        "asset_in_malaysia": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "The rented asset is located in Malaysia (within 12 nautical miles of the baselines).",
          "x-family": "scope_and_exemption",
          "x-rules": ["MS-4", "K-7"],
          "properties": {"value": {"type": ["boolean", "null"]}}
        },
        "financial_lease": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "The rental is a financial lease.",
          "x-family": "scope_and_exemption",
          "x-rules": ["MS-4"],
          "properties": {"value": {"type": ["boolean", "null"]}}
        },
        "air_route": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "For Group I item 10: the flight route.",
          "x-family": "scope_and_exemption",
          "x-rules": ["MS-4"],
          "properties": {
            "value": {
              "enum": [
                "within_peninsula",
