        "hotel_reimbursement": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "Hotel accommodation reimbursed in the line (left out of the gross amount).",
          "x-family": "withholding",
          "x-rules": ["WH-2"],
          "properties": {"value": {"type": ["string", "null"], "pattern": "^-?\\d+(\\.\\d{1,2})?$"}}
        },
        "certificate_of_residence": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "The case holds the payee's certificate of residence (needed for a treaty rate).",
          "x-family": "withholding",
          "x-rules": ["WH-1", "WH-2", "WH-4"],
          "properties": {"value": {"type": ["boolean", "null"]}}
