          "x-family": "contract",
          "x-rules": ["L-4"],
          "properties": {"value": {"type": ["boolean", "null"]}}
        },
        "client_established_in_malaysia": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "The client of the offshore or onshore facility is established in Malaysia.",
          "x-family": "contract",
          "x-rules": ["L-6"],
          "properties": {"value": {"type": ["boolean", "null"]}}
        },
        "exemption_statement_on_invoice": {
