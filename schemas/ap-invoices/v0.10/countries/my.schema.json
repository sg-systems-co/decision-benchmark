          "x-family": "split",
          "x-rules": ["P-12"],
          "properties": {"value": {"type": ["boolean", "null"]}}
        },
        "package_single_price": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "Several services from one Group A-E operator are sold as one package at one price.",
          "x-family": "split",
          "x-rules": ["MS-2"],
          "properties": {"value": {"type": ["boolean", "null"]}}
        },
        "contract_signed": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "Date the written contract was signed.",
          "x-family": "contract",
          "x-rules": ["K-4", "L-1"],
          "properties": {"value": {"type": ["string", "null"], "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}}
        },
        "contract_stamped": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "Date the contract was stamped by LHDN.",
          "x-family": "contract",
          "x-rules": ["K-4", "L-1"],
          "properties": {"value": {"type": ["string", "null"], "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}}
        },
        "price_review_clause": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "The contract has a price-review clause.",
          "x-family": "contract",
          "x-rules": ["K-4", "L-1"],
          "properties": {"value": {"type": ["boolean", "null"]}}
        },
        "residential_share": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "Residential share of a mixed development (built-up area).",
          "x-family": "contract",
          "x-rules": ["L-2"],
          "properties": {"value": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}
        },
        "design_and_build": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "The service is to a registered main contractor on a design-and-build project.",
          "x-family": "contract",
          "x-rules": ["L-3"],
          "properties": {"value": {"type": ["boolean", "null"]}}
        },
        "place_of_worship": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "Construction for religious worship and its facilities.",
          "x-family": "contract",
          "x-rules": ["L-4"],
          "properties": {"value": {"type": ["boolean", "null"]}}
        },
        "client_established_in_malaysia": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "The client of the offshore or onshore facility is established in Malaysia.",
          "x-family": "contract",
          "x-rules": ["L-6"],
          "properties": {"value": {"type": ["boolean", "null"]}}
        },
        "exemption_statement_on_invoice": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "The invoice carries the statement or reference numbers the exemption requires.",
          "x-family": "contract",
          "x-rules": ["L-3", "L-6"],
          "properties": {"value": {"type": ["boolean", "null"]}}
        },
        "payment_nature": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "What the payment to a non-resident is, for withholding.",
          "x-family": "withholding",
          "x-rules": ["WH-1", "WH-2", "WH-3", "WH-4"],
          "properties": {
            "value": {
              "enum": [
                "interest",
                "royalty",
                "services_on_property",
                "technical_advice",
                "movable_property_rent",
                "contract_payment",
                "other_gain",
                "public_entertainer",
                "freight",
                "none",
                null
              ]
            }
          }
        },
        "place_of_performance": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "Where the service is performed.",
          "x-family": "withholding",
          "x-rules": ["WH-2"],
          "properties": {"value": {"enum": ["in_country", "outside", "mixed", null]}}
        },
        "in_country_share": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "Share of a mixed contract performed in Malaysia.",
          "x-family": "withholding",
          "x-rules": ["WH-2"],
          "properties": {"value": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}
