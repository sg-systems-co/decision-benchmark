        },
        "carriage": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "For Group J: the leg of carriage.",
          "x-family": "scope_and_exemption",
          "x-rules": ["MS-4", "P-18"],
          "properties": {
            "value": {
              "enum": [
                "domestic",
                "outside_to_outside",
                "last_exit_to_outside",
                "outside_to_first_entry",
                "transshipment",
                "to_licensed_warehouse",
                "door_to_door_international",
                "ocean_peninsula_east_malaysia",
                null
              ]
            }
          }
        },
        "patient_citizen": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "The patient is a Malaysian citizen (Group I items 14-16).",
          "x-family": "scope_and_exemption",
          "x-rules": ["MS-4", "P-13"],
          "properties": {"value": {"type": ["boolean", "null"]}}
        },
        "student_citizen": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "The student is a Malaysian citizen (Group M).",
          "x-family": "scope_and_exemption",
          "x-rules": ["MS-4"],
          "properties": {"value": {"type": ["boolean", "null"]}}
        },
        "oku_holder": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "The trainee or student holds a valid Kad OKU.",
          "x-family": "scope_and_exemption",
          "x-rules": ["MS-4", "P-17"],
          "properties": {"value": {"type": ["boolean", "null"]}}
        },
        "mro_aircraft_ship": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "Maintenance, repair or overhaul of an aircraft or ship.",
          "x-family": "scope_and_exemption",
          "x-rules": ["P-9"],
          "properties": {"value": {"type": ["boolean", "null"]}}
        },
        "building_charge": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "Charge by a developer, JMB or MC.",
          "x-family": "scope_and_exemption",
          "x-rules": ["P-10", "P-11"],
          "properties": {"value": {"enum": ["maintenance", "sinking_fund", "warranty_repair", "none", null]}}
        },
        "personal_use": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "The service is for personal consumption.",
          "x-family": "buyer_and_purpose",
          "x-rules": ["MS-5"],
          "properties": {"value": {"type": ["boolean", "null"]}}
        },
        "same_service_as_buyer": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "The buyer itself provides a taxable service under the same First Schedule item.",
          "x-family": "buyer_and_purpose",
          "x-rules": ["MS-5", "MS-8"],
          "properties": {"value": {"type": ["boolean", "null"]}}
        },
        "sublet": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "The buyer rents the asset to sublet or sublease it (Order item 8).",
          "x-family": "buyer_and_purpose",
          "x-rules": ["MS-5"],
          "properties": {"value": {"type": ["boolean", "null"]}}
        },
        "sublet_share": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "Share of the rented asset that is sublet.",
          "x-family": "buyer_and_purpose",
          "x-rules": ["MS-5"],
          "properties": {"value": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}
        },
        "supplier_paid": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "The overseas supplier of an imported service has been paid (STP 2/2020).",
          "x-family": "buyer_and_purpose",
          "x-rules": ["MS-8"],
          "properties": {"value": {"type": ["boolean", "null"]}}
        },
        "materials_works_separated": {
          "$ref": "../output.schema.json#/$defs/fact",
          "description": "The invoice shows materials and construction work separately.",
          "x-family": "split",
          "x-rules": ["L-8"],
          "properties": {"value": {"type": ["boolean", "null"]}}
        },
        "installation_separated": {
